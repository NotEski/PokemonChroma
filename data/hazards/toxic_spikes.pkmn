from pkmn_imports import *

@hazard("toxic_spikes")
class ToxicSpikes:
    display_name = "Toxic Spikes"

    def on_entry(self, pokemon: BattleMon, layer_count: int) -> None:
        if layer_count == 0:
            return  # No effect if there are no layers

        if pokemon.has_type("flying") or pokemon.has_ability("levitate"):
            return  # No effect on Flying-type or Levitate ability

        if pokemon.has_ability("immunity"):
            return  # No effect on Immunity ability

        if layer_count == 1:
            status = get_status_condition("poisoned")
            pokemon.apply_status(status)
        elif layer_count >= 2:
            status = get_status_condition("badly_poisoned")
            pokemon.apply_status(status)