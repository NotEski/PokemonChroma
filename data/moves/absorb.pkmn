from pkmn_imports import *

@move("absorb")
class Absorb(BaseMove):
    meta = MoveMetaData(
        display_name="Absorb",
        index=1,
        type=PokemonType("grass"),
        damage_class=DamageClass.SPECIAL,
        category=MoveCategory.DAMAGE,
        accuracy=100,
        power=20,
        pp=25,
        target=MoveTarget.SELECTED_POKEMON,
    )
    drain = 50