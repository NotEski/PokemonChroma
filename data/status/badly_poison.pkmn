from pkmn_imports import *

@status("badly_poison")
class BadlyPoisonStatus:
    meta = {
        "mutual_exclusive": True
    }
    def on_inflicted(self, pokemon: BattleMon) -> None:
        print("Badly Poison status effect inflicted")

    def on_turn_end(self, pokemon: BattleMon) -> None:
        print("Badly Poison status effect on turn end")